# Vercel / local environment variables

# (Optional) Deterministic API key. Set this so CLI auth works across serverless
# instances (Vercel has an ephemeral read-only filesystem). If unset, a random key
# is generated per cold start (still works locally).
SEED_API_KEY=sk-your-own-secret-key-here

# Required for IMAGE generation. Your browser's DeepAI device cookie id.
# Find it at deepai.org in DevTools → Application → Cookies → deepai_device_id.
# Anonymous image quota is limited per device; refresh with a new id once exhausted.
DEEPAI_DEVICE_ID=
